{
  "name": "telecom-3d-reviewer",
  "version": "1.1.0-experimental",
  "description": "Deterministic Graph Cable Routing, Formal Rule Validator & Real Cactus-Needle Foundation Model Assistant with 3D Preview",
  "type": "module",
  "scripts": {
    "test": "node tests/run_all_tests.js && python tests/test_real_needle.py",
